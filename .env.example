# Deixe ambas vazias para rodar a simulação completa no navegador
# (MSW para a API REST e simulador local para os eventos).
#
# Preenchidas, a aplicação fala com os serviços reais e nenhum mock
# entra no bundle do usuário.

# VITE_API_URL=https://api.exemplo.com

# Servidor de eventos local, para exercitar o caminho real do socket.io-client:
#   npm run eventos                  (ou eventos:fora-de-ordem)
#   VITE_SOCKET_URL=http://localhost:3001 npm run dev
# VITE_SOCKET_URL=http://localhost:3001
